#!/usr/bin/env bash
set -euo pipefail
# Credenciales ficticias y endpoint fijo, sin modificar los perfiles de AWS del usuario.
for arg in "$@"; do
  case "$arg" in
    --endpoint-url*|--profile*)
      echo 'Este comando está reservado para LocalStack; no admite cambiar endpoint ni perfil.' >&2
      exit 2
      ;;
  esac
done
unset AWS_PROFILE AWS_DEFAULT_PROFILE AWS_SESSION_TOKEN AWS_SECURITY_TOKEN
export AWS_ACCESS_KEY_ID=test AWS_SECRET_ACCESS_KEY=test
export AWS_CONFIG_FILE=/dev/null AWS_SHARED_CREDENTIALS_FILE=/dev/null
export AWS_DEFAULT_REGION=us-east-1 AWS_REGION=us-east-1
export AWS_EC2_METADATA_DISABLED=true AWS_PAGER='' AWS_CLI_AUTO_PROMPT=off
exec aws --endpoint-url=http://127.0.0.1:4566 --region=us-east-1 "$@"
