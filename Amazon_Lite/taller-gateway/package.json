{
  "name": "taller-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Gateway de microservicios para Amazon Lite con API Gateway y JWT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepare:local": "node scripts/preparar-local.cjs",
    "deploy:local": "bash scripts/serverless-local.sh deploy",
    "info:local": "bash scripts/serverless-local.sh info",
    "verify:local": "node scripts/verificar-local.cjs",
    "remove:local": "bash scripts/serverless-local.sh remove",
    "deploy:develop": "serverless deploy --stage develop",
    "deploy:prod": "serverless deploy --stage prod"
  },
  "dependencies": {
    "jsonwebtoken": "9.0.3"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "serverless": "3.40.0",
    "serverless-esbuild": "1.57.2",
    "serverless-localstack": "1.4.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3"
  }
}
